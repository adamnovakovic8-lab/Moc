const { name, class: cls = '', label } = Astro.props;
---

<svg
  class:list={['icon', cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={icons[name]}></path>
</svg>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
</style>
