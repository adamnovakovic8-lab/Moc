---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Estimator from '../components/Estimator.astro';
import LeadForm from '../components/LeadForm.astro';
import site from '../data/site.json';
import { getCarts, priceOf } from '../lib/inventory.js';

const carts = getCarts();
const median = [...carts.map(priceOf)].sort((a, b) => a - b)[Math.floor(carts.length / 2)] ?? 22000;
---

<Base
  title="Golf Cart Financing in Niagara — In-House"
  description="In-house golf cart financing at RCR Performance in Niagara Falls. Estimate a monthly payment, then talk to us. No sensitive information collected online."
>
  <PageHero title="Financing" lede="We offer in-house financing, set up right here at the shop. Use the calculator for a rough idea, then give Kim a call." />

  <section class="section grain">
    <div class="wrap fin">
      <div class="fin__est">
        <h2>Payment calculator</h2>
        <Estimator price={median} />
      </div>
      <div class="fin__how">
        <h2>How it works</h2>
        <ol>
          <li><strong>Pick a cart</strong> — one from the lot, or a custom build.</li>
          <li><strong>Get in touch</strong> — call {site.phone} or send the form below. Just the basics; nothing sensitive online.</li>
          <li><strong>Apply with us</strong> — we go through the application with you in person.</li>
          <li><strong>Take it home</strong> — or we'll deliver it.</li>
        </ol>
        <p class="small muted">Trade-ins welcome. Payments shown are estimates only and depend on approval.</p>
      </div>
    </div>
  </section>

  <section class="section pq" id="form" aria-labelledby="form-title">
    <div class="wrap pq__grid">
      <div>
        <h2 id="form-title">Start the conversation</h2>
        <p><strong>Please don't send your SIN, banking or income details here.</strong> We only collect that in person.</p>
      </div>
      <LeadForm
        type="financing"
        submit="Send"
        fields={[
          { name: 'interest', label: 'What are you looking at?', type: 'radio', options: ['A cart on the lot', 'A custom build', 'Not sure yet'] },
          { name: 'budget', label: 'Monthly budget', type: 'select', half: true, options: ['Under $300', '$300–$400', '$400–$500', '$500+', 'Not sure'] },
          { name: 'down', label: 'Down payment', type: 'select', half: true, options: ['None', 'Under $2,000', '$2,000–$5,000', '$5,000+', 'Trade-in'] },
          { name: 'message', label: 'Anything else', type: 'textarea' },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .fin {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .fin__how ol {
    padding-left: 22px;
    display: grid;
    gap: 12px;
    margin: 16px 0 20px;
  }
  .pq {
    background: var(--paper-2);
  }
  .pq__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr;
    gap: clamp(28px, 5vw, 72px);
  }
  @media (max-width: 860px) {
    .fin,
    .pq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
