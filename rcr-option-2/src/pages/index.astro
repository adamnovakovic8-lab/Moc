---
import Base from '../layouts/Base.astro';
import Ignition from '../components/Ignition.astro';
import CartCard from '../components/CartCard.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Hours from '../components/Hours.astro';
import Checker from '../components/Checker.astro';
import site from '../data/site.json';
import reviews from '../data/reviews.json';
import { getCarts, money, priceOf } from '../lib/inventory.js';

const carts = getCarts();
const grid = carts;
const lowest = Math.min(...carts.map(priceOf));
const highest = Math.max(...carts.map(priceOf));
const { rate, defaultTerm } = site.financing;
const r = rate / 100 / 12;
const fromMonthly = Math.round((lowest * 0.9 * r) / (1 - Math.pow(1 + r, -defaultTerm)));
const kathy = reviews.find((rv) => rv.name === 'Kathy Klune')!;
const others = reviews.filter((rv) => rv !== kathy);

const headline = ["Niagara's", 'custom', 'cart shop'];

const mosaic = [
  { src: 'builds/princess/side.jpg', alt: 'Purple custom cart with gold crown decals', fig: 'The Princess cart', cls: 'm1' },
  { src: 'builds/teal/side.jpg', alt: 'Teal and white cart with chrome wheels', fig: 'Teal & white', cls: 'm2' },
  { src: 'builds/lime/side.jpg', alt: 'Lime green lifted cart', fig: 'Lime green, lifted', cls: 'm3' },
  { src: 'builds/copper/side.jpg', alt: 'Copper cart with tan striped seats', fig: 'Copper & tan', cls: 'm4' },
  { src: 'builds/blue-lifted/front.jpg', alt: 'Front of a lifted blue cart with brush guard', fig: 'Blue, lifted', cls: 'm5' },
];

const pit = [
  { n: 'R', href: '/rentals', title: 'Rentals', what: 'Daily, weekly or monthly. Gas or electric, four seats or six. Serviced and ready to go.' },
  { n: 'S', href: '/storage', title: 'Storage', what: 'Off-season or year-round. Inspection going in, battery kept charged, ready when you call.' },
  { n: 'F', href: '/service', title: 'Service', what: 'Maintenance, repairs and lithium conversions on any make. Pick-up available.' },
  { n: '$', href: '/financing', title: 'Financing', what: 'In-house financing, set up at the shop. Trade-ins welcome.' },
];
---

<Base
  title="RCR Performance Golf Carts — Niagara's custom cart shop"
  description="New MadJax golf carts, custom builds, rentals, storage and repairs at 10569 Montrose Road, Niagara Falls. Family-run by Rob and Kim since 2017. Call 905-348-1965."
>
  <script is:inline slot="head">
    try {
      if (!sessionStorage.getItem('rcr-ignition')) {
        document.documentElement.classList.add('intro-on');
        sessionStorage.setItem('rcr-ignition', '1');
      }
    } catch (e) {}
  </script>
  <Ignition slot="before-header" />

  <!-- ============ HERO ============ -->
  <section class="hero dark" aria-labelledby="hero-title">
    <div class="hero__photo" data-hero-art>
      <video class="hero__video" autoplay muted loop playsinline preload="auto" poster="/videos/hero-poster.jpg" aria-hidden="true">
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="wrap hero__inner">
      <div class="hero__card mono" aria-label="About RCR">
        <span>Est. {site.foundedYear}</span>
        <span>Family-run</span>
        <span>Rob &amp; Kim</span>
        <a href={site.phoneHref} data-track="hero-card">{site.phone}</a>
      </div>
      <div class="hero__copy">
        <p class="kicker">{site.address.street} · {site.address.city}</p>
        <h1 id="hero-title" class="hero__title">
          <span class="visually-hidden">{headline.join(' ')}</span>
          <span aria-hidden="true">
            {
              headline.map((w, wi) => (
                <span class:list={['hero__line', wi === 1 && 'hl']}>
                  {[...w].map((ch) => (
                    <span class="hero__char" data-hero-char>
                      {ch === ' ' ? ' ' : ch}
                    </span>
                  ))}
                </span>
              ))
            }
          </span>
        </h1>
        <p class="lede">
          New MadJax carts, custom builds, rentals, storage and service — from a family shop that's been at it since
          {site.foundedYear}.
        </p>
        <div class="hero__ctas">
          <a href="/inventory" class="btn">See the carts <Icon name="arrow" /></a>
          <a href="/custom-builds" class="btn btn--line">Custom builds</a>
        </div>
      </div>
    </div>
    <div class="livery hero__livery" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>

  <!-- ============ AD ============ -->
  <section class="ad dark" aria-label="RCR Performance video">
    <video
      class="ad__video"
      data-ad-video
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/rcr-ad-poster.jpg"
      aria-label="The MadJax Ascent at sunset: Arrive in style. Built for the long way home. RCR Performance, Niagara Falls."
    >
      <source src="/videos/rcr-ad-real.webm" type="video/webm" />
      <source src="/videos/rcr-ad-real.mp4" type="video/mp4" />
    </video>
  </section>
  <script>
    // Play the ad from the start only while it's on screen; reduced-motion users get controls instead.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('[data-ad-video]').forEach((ad) => {
      if (reduced) {
        ad.controls = true;
      } else {
        new IntersectionObserver(([e]) => (e.isIntersecting ? ad.play().catch(() => {}) : ad.pause()), {
          threshold: 0.5,
        }).observe(ad);
      }
    });
  </script>

  <!-- ============ AD (SPLIT) ============ -->
  <section class="adsplit section" aria-labelledby="adsplit-title">
    <div class="wrap adsplit__inner">
      <div class="adsplit__media">
        <video
          class="adsplit__video"
          data-ad-video
          muted
          loop
          playsinline
          preload="metadata"
          poster="/videos/rcr-ad-poster.jpg"
          aria-label="The MadJax Ascent at sunset: Arrive in style. Built for the long way home. RCR Performance, Niagara Falls."
        >
          <source src="/videos/rcr-ad-real.webm" type="video/webm" />
          <source src="/videos/rcr-ad-real.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="adsplit__copy">
        <p class="kicker">Take the long way</p>
        <h2 id="adsplit-title">Built for the long way home</h2>
        <p class="adsplit__lede">
          New MadJax carts, set up and serviced in our Niagara Falls shop. Family-run by Rob &amp; Kim since {site.foundedYear}.
        </p>
        <dl class="adsplit__facts">
          <div><dt class="mono">In stock</dt><dd>{carts.length} new MadJax carts</dd></div>
          <div><dt class="mono">Price</dt><dd>{money(lowest)} – {money(highest)} + HST</dd></div>
          <div><dt class="mono">Financing</dt><dd>From {money(fromMonthly)}/mo*</dd></div>
        </dl>
        <div class="adsplit__ctas">
          <a href="/inventory" class="btn btn--purple">See the carts <Icon name="arrow" /></a>
          <a href={site.phoneHref} class="btn btn--line" data-track="adsplit-call">Call {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE GRID ============ -->
  <section class="grid section" aria-labelledby="grid-title">
    <div class="wrap">
      <div class="grid__head">
        <div>
          <p class="kicker">01 — On the lot</p>
          <h2 id="grid-title">The starting grid</h2>
        </div>
        <p class="grid__sub">
          {carts.length} new 2025 MadJax X-Series carts, all on 105 AH lithium.
          <span class="mono">{money(lowest)} – {money(highest)} + HST</span>
        </p>
      </div>
      <ol class="grid__list">
        {
          grid.map((cart, i) => (
            <li>
              <CartCard cart={cart} number={i + 1} sizes="(min-width: 900px) 30vw, 92vw" />
            </li>
          ))
        }
      </ol>
      <p class="grid__more"><a href="/inventory" class="btn btn--purple">Filter all carts <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- ============ BUILDS ============ -->
  <section class="builds section dark cut-top" aria-labelledby="builds-title">
    <div class="wrap">
      <div class="builds__head">
        <div>
          <p class="kicker">02 — Built here</p>
          <h2 id="builds-title">Custom builds</h2>
        </div>
        <div class="builds__text">
          <p>Paint, decals, lift kits, wheels, seats, lights and sound. Every one of these came out of our shop on Montrose Road.</p>
          <a href="/custom-builds" class="btn">Start a build <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="mosaic">
        {
          mosaic.map((m, i) => (
            <figure class:list={['mosaic__item', m.cls]} data-drop>
              <Photo src={m.src} alt={m.alt} sizes="(min-width: 900px) 40vw, 92vw" widths={[400, 700, 1000]} />
              <figcaption class="mono">
                Fig. {String(i + 1).padStart(2, '0')} — {m.fig}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PIT LANE ============ -->
  <section class="pit section" aria-labelledby="pit-title">
    <div class="wrap pit__grid">
      <div>
        <p class="kicker">03 — Pit lane</p>
        <h2 id="pit-title">Not buying? We still do a lot.</h2>
        <table class="pit__table">
          <thead class="mono">
            <tr><th scope="col">Bay</th><th scope="col">What</th><th scope="col">Details</th><th scope="col"><span class="visually-hidden">Link</span></th></tr>
          </thead>
          <tbody>
            {
              pit.map((p) => (
                <tr>
                  <td class="pit__n">{p.n}</td>
                  <th scope="row" class="pit__t"><a href={p.href}>{p.title}</a></th>
                  <td>{p.what}</td>
                  <td class="pit__go" aria-hidden="true"><Icon name="arrow" /></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <figure class="pit__photo" data-drop>
        <Photo src="shop/delivery-trailer.jpg" alt="Golf carts loaded on RCR's trailer for delivery" sizes="(min-width: 900px) 40vw, 92vw" widths={[400, 700, 858]} />
        <figcaption class="fig">Loaded up for a delivery</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ FINANCING ============ -->
  <section class="fin" aria-labelledby="fin-title">
    <Checker class="fin__chk" rows={2} size={16} />
    <div class="wrap fin__inner">
      <p class="fin__num"><span class="mono">From</span> {money(fromMonthly)}<span class="fin__mo">/mo*</span></p>
      <div>
        <h2 id="fin-title">In-house financing</h2>
        <p>Set up right here at the shop — no running back and forth to a bank. Trade-ins welcome.</p>
        <a href="/financing" class="btn btn--purple">Work out a payment <Icon name="arrow" /></a>
      </div>
    </div>
    <p class="wrap mono fin__fine">*Example: {money(lowest)}, 10% down, {defaultTerm} mo at a sample {rate}% APR, O.A.C. Taxes extra.</p>
  </section>

  <!-- ============ REVIEWS ============ -->
  <section class="rev section" aria-labelledby="rev-title">
    <div class="wrap">
      <p class="kicker">04 — Customers</p>
      <h2 id="rev-title" class="visually-hidden">What customers say</h2>
      <figure class="rev__lead">
        <blockquote><p>"{kathy.quote}"</p></blockquote>
        <figcaption class="mono">{kathy.name} — {kathy.context}</figcaption>
      </figure>
      <ul class="rev__row" tabindex="0" aria-label="More reviews, scroll sideways">
        {
          others.map((rv) => (
            <li>
              <blockquote>
                <p>"{rv.quote}"</p>
              </blockquote>
              <p class="mono rev__who">{rv.name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PIT BOARD / VISIT ============ -->
  <section class="visit dark cut-top" aria-labelledby="visit-title">
    <div class="wrap visit__grid">
      <div class="board">
        <h2 id="visit-title" class="board__h">Box this lap</h2>
        <a href={site.phoneHref} class="board__phone" data-track="pit-board">{site.phone}</a>
        <p class="board__line mono">{site.address.street}</p>
        <p class="board__line mono">{site.address.city} {site.address.region} {site.address.postal}</p>
        <div class="board__hours"><Hours /></div>
        <a href="https://maps.google.com/?q=10569+Montrose+Road,+Niagara+Falls,+ON" class="btn" target="_blank" rel="noopener">Directions <Icon name="arrow" /></a>
      </div>
      <MapEmbed class="visit__map" />
    </div>
  </section>
</Base>

<style>
  /* ---------- Ad ---------- */
  .ad {
    background: #000;
  }
  .ad__video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 100svh;
    object-fit: contain; /* never crop the ad's baked-in text */
  }

  /* ---------- Ad (split) ---------- */
  .adsplit__inner {
    max-width: 1720px; /* wider than the site's content width so the video can be big */
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .adsplit__video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #000;
    border-radius: 4px;
  }
  .adsplit__copy h2 {
    margin: 0 0 16px;
  }
  .adsplit__lede {
    margin: 0 0 28px;
    max-width: 44ch;
  }
  .adsplit__facts {
    margin: 0 0 32px;
    border-top: 1px solid var(--line);
  }
  .adsplit__facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .adsplit__facts dt {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .adsplit__facts dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .adsplit__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 900px) {
    .adsplit__inner {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__photo :global(picture) {
    height: 100%;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
    .hero__photo { background: url(/videos/hero-poster.jpg) center / cover; }
  }
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(21 15 36 / 0.92) 0%, rgb(21 15 36 / 0.7) 38%, rgb(21 15 36 / 0) 70%),
      linear-gradient(0deg, rgb(21 15 36 / 0.85) 0%, transparent 45%);
  }
  .hero__inner {
    position: relative;
    padding-top: calc(var(--header-h) + 60px);
    padding-bottom: 56px;
  }
  .hero__card {
    position: absolute;
    top: calc(var(--header-h) + 40px);
    right: var(--gutter);
    display: grid;
    gap: 2px;
    background: rgb(21 15 36 / 0.75);
    border-left: 4px solid var(--yellow);
    padding: 12px 16px;
    backdrop-filter: blur(4px);
  }
  .hero__card a {
    color: var(--yellow);
    text-decoration: none;
    margin-top: 4px;
  }
  .hero__copy {
    max-width: 900px;
  }
  .hero__title {
    font-size: clamp(2.2rem, 6.4vw, 6.2rem);
    margin-bottom: 0.3em;
  }
  .hero__line {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    padding: 0 0.08em 0.04em 0;
  }
  .hero__char {
    display: inline-block;
  }
  .hero .lede {
    color: #e3def0;
    max-width: 46ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 26px;
  }
  .hero__livery {
    position: relative;
  }
  @media (max-width: 700px) {
    .hero__card {
      display: none;
    }
    .hero__photo::after {
      background: linear-gradient(0deg, rgb(21 15 36 / 0.95) 0%, rgb(21 15 36 / 0.6) 60%, rgb(21 15 36 / 0.2) 100%);
    }
  }

  /* ---------- Grid ---------- */
  .grid__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 12px 40px;
    margin-bottom: 40px;
  }
  .grid__head h2 {
    margin: 0;
  }
  .grid__sub {
    margin: 0;
    max-width: 40ch;
    display: grid;
    gap: 4px;
  }
  .grid__list {
    list-style: none;
    margin: 0;
    padding: 0 0 80px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  /* staggered like a starting grid */
  .grid__list > li:nth-child(3n + 2) {
    transform: translateY(80px);
  }
  .grid__list > li:nth-child(3n) {
    transform: translateY(40px);
  }
  .grid__more {
    margin: 24px 0 0;
  }
  @media (max-width: 900px) {
    .grid__list {
      grid-template-columns: 1fr 1fr;
      padding-bottom: 60px;
    }
    .grid__list > li:nth-child(n) {
      transform: none;
    }
    .grid__list > li:nth-child(even) {
      transform: translateY(60px);
    }
  }
  @media (max-width: 560px) {
    .grid__list {
      grid-template-columns: 1fr;
      padding-bottom: 0;
    }
    .grid__list > li:nth-child(n) {
      transform: none;
    }
  }

  /* ---------- Builds mosaic ---------- */
  .builds__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 56px;
    align-items: end;
    margin-bottom: 40px;
  }
  .builds__text p {
    color: #ddd7ea;
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: clamp(140px, 16vw, 220px);
    gap: 8px;
  }
  .mosaic__item {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .mosaic__item :global(picture) {
    height: 100%;
  }
  .mosaic__item figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    background: var(--purple-950);
    color: #fff;
    padding: 6px 10px;
  }
  .m1 {
    grid-column: span 3;
    grid-row: span 2;
  }
  .m2 {
    grid-column: span 3;
    grid-row: span 2;
  }
  .m3 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .m4 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .m5 {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (max-width: 760px) {
    .builds__head {
      grid-template-columns: 1fr;
    }
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
    }
    .m1,
    .m2 {
      grid-column: span 2;
    }
    .m3,
    .m4,
    .m5 {
      grid-column: span 1;
      grid-row: span 1;
    }
    .m5 {
      grid-column: span 2;
    }
  }

  /* ---------- Pit lane ---------- */
  .pit__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .pit__table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
  }
  .pit__table thead th {
    text-align: left;
    font-weight: 600;
    color: var(--ink-soft);
    padding: 0 12px 10px 0;
    border-bottom: 2px solid var(--ink);
  }
  .pit__table tbody tr {
    position: relative;
    border-bottom: 1px solid var(--rule);
    transition: background 0.15s;
  }
  .pit__table tbody tr:hover {
    background: var(--mist);
  }
  .pit__table td,
  .pit__table tbody th {
    padding: 18px 12px 18px 0;
    vertical-align: top;
    text-align: left;
  }
  .pit__n {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--purple);
    width: 48px;
  }
  .pit__t {
    font-stretch: 125%;
    font-style: italic;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.15rem;
    white-space: nowrap;
  }
  .pit__t a {
    text-decoration: none;
  }
  .pit__t a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pit__go {
    width: 32px;
    color: var(--purple);
  }
  .pit__photo {
    margin: 0;
  }
  .pit__photo :global(picture) {
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
    aspect-ratio: 1;
  }
  @media (max-width: 860px) {
    .pit__grid {
      grid-template-columns: 1fr;
    }
    .pit__table thead {
      display: none;
    }
    .pit__table tbody tr {
      display: grid;
      grid-template-columns: 36px 1fr;
      padding: 14px 0;
    }
    .pit__table td,
    .pit__table tbody th {
      padding: 0;
    }
    .pit__table tbody td:nth-child(3) {
      grid-column: 2;
      margin-top: 4px;
    }
    .pit__go {
      display: none;
    }
  }

  /* ---------- Financing ---------- */
  .fin {
    position: relative;
    background: var(--yellow);
    color: var(--ink);
    padding: calc(clamp(48px, 6vw, 72px) + 32px) 0 28px;
  }
  .fin :global(.fin__chk) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }
  .fin__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(24px, 6vw, 96px);
    align-items: center;
  }
  .fin__num {
    margin: 0;
    font-stretch: 125%;
    font-style: italic;
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: 0.9;
    display: grid;
  }
  .fin__num .mono {
    font-style: normal;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .fin__mo {
