# Email leads to Kim via Resend (https://resend.com). Leave blank to only log leads to data/leads.jsonl.
RESEND_API_KEY=
LEAD_TO=info@rcrperformance.ca
LEAD_FROM=RCR Website <website@rcrperformance.ca>

# Where leads.jsonl is written (defaults to ./data)
LEAD_DIR=

# Newsletter: POST endpoint for the client's email tool (Mailchimp/Klaviyo webhook, Zapier, etc.)
NEWSLETTER_WEBHOOK=

# Node server
HOST=0.0.0.0
PORT=4321
