<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Welcome to High School</title>
  <meta name="description" content="Advice for Grade 8 students coming to Corpus Christi, from someone who just finished Grade 9.">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <script>try { if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme; } catch (e) {}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="/" aria-label="Welcome to High School home">
      <img src="/images/corpus-logo.png" alt="Corpus Christi Catholic Secondary School" width="837" height="200">
      <span class="site-name">Welcome to<br>High School</span>
    </a>
    <nav id="nav" aria-label="Main">
      <% nav.forEach(([href, , label]) => { %>
        <a href="<%= href %>" <%- href === path ? 'aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <button class="round-btn" id="theme" aria-label="Switch to dark mode">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
    </button>
    <button class="round-btn menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav" aria-label="Menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v2.5H4zM4 11h16v2.5H4zM4 16h16v2.5H4z"/></svg></button>
  </div>
</header>
<main id="main">
